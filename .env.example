# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Platizio REST API (browser calls this; never Finprim/Cybrilla directly).
# Local dev: use "/api/v1" so Vite proxies to Spring Boot (avoids CORS + cookie issues on HTTP).
VITE_API_BASE_URL="/api/v1"

# VITE_BACKEND_ORIGIN: Spring Boot server used by the Vite proxy and investor-action links.
# Investor confirm/payment pages are served at {VITE_BACKEND_ORIGIN}/investor-actions/{token}.
VITE_BACKEND_ORIGIN="http://localhost:8081"

# Dev server runs on port 3000 (see package.json "dev" script). KYC modify callbacks use window.location.origin.

# VITE_CYBRILLA_SANDBOX: Show sandbox UI hints (true/false). Auto-detected for local backend URLs.
# VITE_CYBRILLA_SANDBOX=true

# VITE_CYBRILLA_SANDBOX_STRICT_SIMULATOR: When true, block non-simulator PANs client-side (QA only).
# Cybrilla tenants normally accept any valid PAN (AAAAA9999A) — leave this unset/false.
# VITE_CYBRILLA_SANDBOX_STRICT_SIMULATOR=false
