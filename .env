# Relative URL → Vite dev proxy to Spring Boot (same-origin; auth cookies work on HTTP).
# This worktree: frontend runs on :3002 and proxies /api/v1 to the backend on :8081
# (matches start-backend.ps1 default, application.yml default, and .env.example).
VITE_API_BASE_URL="/api/v1"
VITE_BACKEND_ORIGIN="http://localhost:8081"
