# Backend listens here (8081 avoids Windows Apache/httpd on 8080).
SERVER_PORT=8081

# Local dev: React on :3000 calls API on :8081 (cross-origin). SameSite=None + secure=false on localhost.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=None
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL) ---
# The DB username defaults to 'postgres' in application.yml; the password has NO default — the app will not start without it.
DB_PASSWORD=

# --- Auth / JWT (required; no default — the app will not start without it) ---
# HS256 signing secret for access tokens. Use a long random value (>= 32 bytes), e.g.: openssl rand -base64 48
JWT_SECRET=

# sandbox | production
CYBRILLA_ENVIRONMENT=sandbox

# --- Sandbox (simulator PANs only; does NOT verify real PANs against ITD) ---
CYBRILLA_PRE_VERIFICATION_BASE_URL=https://api.sandbox.cybrilla.com
CYBRILLA_REAL_CLIENT_ENABLED=true
CYBRILLA_PRE_VERIFICATION_TOKEN_URL=https://s.finprim.com/v2/auth/cybrillarta/token
CYBRILLA_PRE_VERIFICATION_CLIENT_ID=
CYBRILLA_PRE_VERIFICATION_CLIENT_SECRET=
CYBRILLA_TOKEN_REFRESH_BUFFER_SECONDS=120
# Leave unset to auto-enforce simulator PAN patterns in sandbox mode.
# CYBRILLA_ENFORCE_SANDBOX_PAN_PATTERNS=true

# --- Production (live PAN/KYC verification for any valid Indian PAN) ---
# Request production credentials from Cybrilla onboarding after going-live checklist.
# CYBRILLA_ENVIRONMENT=production
# CYBRILLA_PRE_VERIFICATION_BASE_URL=https://api.cybrilla.com
# CYBRILLA_PRE_VERIFICATION_TOKEN_URL=https://api.fintechprimitives.com/v2/auth/cybrillarta/token
# CYBRILLA_PRE_VERIFICATION_CLIENT_ID=<production-poa-client-id-without-_test_>
# CYBRILLA_PRE_VERIFICATION_CLIENT_SECRET=<production-poa-client-secret>
# CYBRILLA_ENFORCE_SANDBOX_PAN_PATTERNS=false

FINPRIM_BASE_URL=https://s.finprim.com
# Production Finprim:
# FINPRIM_BASE_URL=https://api.fintechprimitives.com
# x-tenant-id header on FP /v2/... and /api/oms/... calls (use tenant name, e.g. platizio).
FINPRIM_TENANT_NAME=platizio
FINPRIM_TENANT_ID=platizio
# Platizio sandbox tenant token endpoint.
FINPRIM_TENANT_TOKEN_URL=https://s.finprim.com/v2/auth/platizio/token
FINPRIM_TENANT_CLIENT_ID=
FINPRIM_TENANT_CLIENT_SECRET=
FINPRIM_TOKEN_REFRESH_BUFFER_SECONDS=120

# Product catalogue: cybrilla (live Finprim) or local (PostgreSQL seed rows)
CYBRILLA_PRODUCT_CATALOGUE_SOURCE=cybrilla
# poa-mf (default POA-orderable MF) | oms-fund-schemes | sif-poa
CYBRILLA_PRODUCT_CATALOGUE_ENDPOINT=poa-mf

EXTERNAL_AUTH_TOKEN_CACHE_ENABLED=true
# Optional. Leave unset to use: <user-home>/.platizio-wealthtech/external-auth-token-cache.json
# EXTERNAL_AUTH_TOKEN_CACHE_FILE=
# Generate tokens on backend startup, then check exactly every 30 minutes.
# Cached tokens are reused between checks; normal API calls do not regenerate them unless expired.
EXTERNAL_AUTH_AUTO_REFRESH_ENABLED=true
EXTERNAL_AUTH_AUTO_REFRESH_CHECK_INTERVAL_MS=1800000
EXTERNAL_AUTH_AUTO_REFRESH_STARTUP_DELAY_MS=1800000
EXTERNAL_AUTH_DEBUG_ENABLED=false
EXTERNAL_AUTH_LOG_RAW_TOKENS=false

# Cybrilla webhooks (required outside local profile)
CYBRILLA_WEBHOOK_SECRET=

# Frontend origin for Digilocker/eSign postback fallback (KYC modify sends window.location.origin from the browser).
# Must match your Vite dev port (this project uses :3000, not Vite's default :5173).
CYBRILLA_KYC_FORM_CALLBACK_BASE_URL=http://localhost:3000
CYBRILLA_IDENTITY_DOCUMENT_POSTBACK_PATH=/distributor/investor-onboarding
CYBRILLA_ESIGN_POSTBACK_PATH=/distributor/investor-onboarding

# Backend URL Finprim posts payment completion to (has a default in application.yml; {token} is substituted per order).
# The default below works for local dev; set a public HTTPS URL/tunnel for non-local so FP can reach it.
PAYMENT_POSTBACK_URL=http://localhost:8081/investor-actions/{token}/payment-complete

# KYC polling fallback when webhooks are delayed
KYC_SYNC_ENABLED=true
KYC_SYNC_INTERVAL_MS=180000

# ── Email OTP (login / signup verification) ──────────────────────────────────
# Free SMTP options (use ONE):
#   Gmail   : MAIL_HOST=smtp.gmail.com   MAIL_PORT=587  MAIL_USERNAME=<you@gmail.com>  MAIL_PASSWORD=<16-char app password>
#   Brevo   : MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_USERNAME=<brevo login> MAIL_PASSWORD=<smtp key>
#   Mailtrap: MAIL_HOST=sandbox.smtp.mailtrap.io MAIL_PORT=587 MAIL_USERNAME=<user> MAIL_PASSWORD=<pass>  (catches mail in a test inbox)
# Leave MAIL_HOST empty to skip real email: the OTP is logged to the console and,
# on the local profile, returned in the API response (devCode) for easy testing.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@platizio.local
MAIL_FROM_NAME=Platizio

OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ── Supabase Auth (GoTrue) — investor email/mobile OTP contact verification ──
# Leave SUPABASE_REAL_CLIENT_ENABLED=false (or unset) to use DisabledSupabaseAuthClient:
# it sends nothing and accepts only the dev code 000000 (local/demo/testing).
# LIVE: the real git-ignored .env sets this true and provides the project URL + anon key
# from the Supabase dashboard → Project Settings → API. Email OTP is live-verified that
# way; the real values live ONLY in the git-ignored .env, never here.
#   - SUPABASE_URL is the bare project URL (no /rest/v1 or /auth/v1 suffix).
#   - SUPABASE_ANON_KEY is the legacy anon JWT (sent as apikey header + bearer token).
#   - The Magic Link email template must include {{ .Token }} to deliver a 6-digit code.
SUPABASE_REAL_CLIENT_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role key is reserved for future admin calls; NOT required for OTP. Keep secret.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CREATE_USER=true
# Mobile/SMS OTP is DEFERRED — the Supabase Phone provider is disabled (likely needs a
# paid plan). While false, the /mobile/otp endpoints return a clean 400 and contact
# status reports smsOtpEnabled=false so the UI hides mobile OTP (self-declaration still
# works). To enable later: turn on Authentication → Providers → Phone (with an SMS
# provider such as Twilio) in the dashboard, then set this true.
SUPABASE_SMS_ENABLED=false
