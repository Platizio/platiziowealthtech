CYBRILLA_PRE_VERIFICATION_BASE_URL=https://api.sandbox.cybrilla.com
CYBRILLA_REAL_CLIENT_ENABLED=true
CYBRILLA_PRE_VERIFICATION_TOKEN_URL=https://s.finprim.com/v2/auth/cybrillarta/token
CYBRILLA_PRE_VERIFICATION_CLIENT_ID=
CYBRILLA_PRE_VERIFICATION_CLIENT_SECRET=
CYBRILLA_TOKEN_REFRESH_BUFFER_SECONDS=0

FINPRIM_BASE_URL=https://s.finprim.com
FINPRIM_TENANT_NAME=platizio
FINPRIM_TENANT_ID=
# Optional. Leave unset to use: https://s.finprim.com/v2/auth/<FINPRIM_TENANT_NAME>/token
# FINPRIM_TENANT_TOKEN_URL=
FINPRIM_TENANT_CLIENT_ID=
FINPRIM_TENANT_CLIENT_SECRET=
FINPRIM_TOKEN_REFRESH_BUFFER_SECONDS=0

EXTERNAL_AUTH_TOKEN_CACHE_ENABLED=true
# Optional. Leave unset to use: <user-home>/.platizio-wealthtech/external-auth-token-cache.json
# EXTERNAL_AUTH_TOKEN_CACHE_FILE=
# Generate tokens on backend startup, then check exactly every 30 minutes.
# Cached tokens are reused between checks; normal API calls do not regenerate them unless expired.
EXTERNAL_AUTH_AUTO_REFRESH_ENABLED=true
EXTERNAL_AUTH_AUTO_REFRESH_CHECK_INTERVAL_MS=1800000
EXTERNAL_AUTH_AUTO_REFRESH_STARTUP_DELAY_MS=1800000
EXTERNAL_AUTH_DEBUG_ENABLED=false
EXTERNAL_AUTH_LOG_RAW_TOKENS=true
